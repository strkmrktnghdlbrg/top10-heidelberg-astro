      "headline": title,
      "description": description,
      "datePublished": datePublished,
      "dateModified": dateModified,
      "author": { "@type": "Organization", "name": "Top 10 Heidelberg" },
      "publisher": { "@type": "Organization", "name": "Top 10 Heidelberg" },
      "mainEntityOfPage": "https://www.top10-heidelberg.de/leitsysteme-gewerbeparks-orientierung/",
      "inLanguage": "de",
    })} />
  </article>
</BaseLayout>

